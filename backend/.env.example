# ==========================================
# InvestHelper 后端环境变量示例
# 复制本文件为 .env 并按需修改：
#   cp .env.example .env
# ==========================================

# 数据库连接 URL
# - SQLite 默认: sqlite:///./invest_helper.db
# - PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./invest_helper.db

# Tushare token（可选）。留空时只使用 AKShare 数据源。
# 在 https://tushare.pro 注册获取。
TUSHARE_TOKEN=

# Redis 缓存（可选）。留空 REDIS_URL 则使用内存缓存（已支持 LRU）。
# REDIS_ENABLED=false 时强制使用内存缓存，即使填了 REDIS_URL。
REDIS_URL=
REDIS_ENABLED=false

# CORS 允许的源（JSON 数组）。本地开发只需 http://localhost:5173。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 后台调度
# 组合快照每日 0 点后第 N 分钟触发
DAILY_SNAPSHOT_DELAY_MINUTES=15
# 财经快讯抓取间隔（秒）
NEWS_CRAWL_INTERVAL_SECONDS=1800

# AKShare 节流：相邻两次网络请求之间最少间隔（毫秒）
AKSHARE_THROTTLE_MS=300

# 内存缓存最大条目数（超限触发 LRU 淘汰）
CACHE_MAX_SIZE=10000