# ==========================================
# InvestHelper 后端环境变量示例
# 复制本文件为 .env 即可：cp .env.example .env
# 大多数字段无需修改即可启动；按需调整。
# ==========================================

# ---------- 数据库 ----------
# SQLite 默认；可换 PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./invest_helper.db

# ---------- 数据源 ----------
# Tushare token（可选）。留空时只使用 AKShare 数据源。
# 注册地址: https://tushare.pro
TUSHARE_TOKEN=

# ---------- 缓存 ----------
# 留空 REDIS_URL 则使用内存缓存（已支持 LRU/TTL）。
# 示例: redis://localhost:6379/0
REDIS_URL=
# 显式禁用 Redis（即使填了 REDIS_URL 也强制使用内存缓存）
REDIS_ENABLED=false

# 内存缓存最大条目数（超限触发 LRU 淘汰）
CACHE_MAX_SIZE=10000

# 缓存 TTL（秒）
CACHE_TTL_DAILY=3600
CACHE_TTL_MINUTE=60
CACHE_TTL_SEARCH=600
CACHE_TTL_REALTIME=30

# ---------- 网络请求 ----------
# AKShare / Tushare 相邻两次请求最小间隔（秒），避免触发数据源限流
MARKET_DATA_REQUEST_INTERVAL=0.3
# 数据源请求超时（秒）
MARKET_DATA_TIMEOUT=30

# ---------- 后台任务 ----------
# 每日组合快照（驱动仪表盘周期收益计算）
DAILY_SNAPSHOT_ENABLED=true
# 每日几点触发（0-23，Asia/Shanghai 时间）
DAILY_SNAPSHOT_HOUR=20

# 财经快讯抓取（定时拉取东方财富/同花顺/新浪）
NEWS_CRAWL_ENABLED=true
# 抓取间隔（秒）
NEWS_CRAWL_INTERVAL=60

# ---------- CORS ----------
# 允许的前端源（JSON 数组）。本地开发只需这两个。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]